{
  "name": "skynet-dashboard",
  "private": true,
  "version": "8.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:remote": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "backend": "node server.cjs --host 127.0.0.1 --port 3000",
    "start": "node server.cjs --host 0.0.0.0 --port 5173",
    "start:local": "node server.cjs --host 127.0.0.1 --port 5173",
    "test": "npm run test:all && npm run test:production",
    "build": "vite build",
    "lint": "eslint .",
    "manifest:update": "node tools/update-manifest.cjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:integration": "node --test tests/integration.cjs",
    "test:all": "node --test tests.cjs tests/integration.cjs tests/unit-core.cjs tests/validators.test.js",
    "test:production": "npm run build && node --test tests/production.cjs",
    "doctor": "node tools/doctor.cjs",
    "benchmark": "node tools/benchmark.cjs",
    "test:unit": "node --test tests/unit-core.cjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
